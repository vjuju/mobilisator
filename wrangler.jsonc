{
	"name": "mobilisator",
	"main": "src/worker.ts",
	"compatibility_date": "2026-02-03",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"env": {
		"dev": {
			"name": "mobilisator-dev",
			"routes": [
				{ "pattern": "dev.mobilisator.fr/*", "zone_name": "mobilisator.fr" }
			]
		}
	}
}
